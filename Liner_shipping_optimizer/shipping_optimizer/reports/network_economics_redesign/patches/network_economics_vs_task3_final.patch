-}
-
-_PORT_REQUIRED = [
-    "unlocode", "name", "latitude", "longitude", "draft",
-    "costperfull", "costperfulltrnsf", "portcallcostfixed", "portcallcostperffe",
-]
-_DEMAND_REQUIRED = ["Origin", "Destination", "FFEPerWeek", "Revenue_1"]
