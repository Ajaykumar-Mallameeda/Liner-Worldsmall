+                    share = port_service_loads[p][s_idx] / port_load[p]
+                    handling = getattr(p_port, "handling_cost", 0.0)
+                    variable = getattr(p_port, "variable_port_call_cost", 0.0)
+                    fixed = getattr(p_port, "port_call_cost", 0.0)
