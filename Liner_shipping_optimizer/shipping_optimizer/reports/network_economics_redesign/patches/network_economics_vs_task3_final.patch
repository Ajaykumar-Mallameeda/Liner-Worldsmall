@@ -0,0 +1,320 @@
+"""Canonical service model: real rotation time, vessels, capacity and weekly cost.
+
+One definition, used by the GA surrogates, the network MILP and (re-derived
+independently) by the ledger.
+
+Frequency
+    ``f`` is the number of departures per week (integer >= 0). A rotation takes a
+    real time ``T`` (days) = sailing at the class design speed + port stays, so
+
+        vessels      N(f) = ceil(T * f / 7)          (T = declared whole days)
+        capacity     cap * f  TEU per week on EVERY leg of the rotation
+        per week     N * TC_daily * 7                vessel hire
+                   + f * rotation_fuel               fuel (sea + port idle)
+                   + f * sum(fixed port-call cost)   port calls
+
+    There is no hard-coded frequency or cycle time: the largest sensible ``f`` is
+    derived from T and from the class inventory (``max_departures``).
+
+Fuel (source-backed, one operating point)
+    sea days  * ``Bunker ton per day at designSpeed`` * price
+  + port days * ``Idle Consumption ton/day``          * price
+    The sailing speed is the class ``designSpeed`` - the only speed for which the
+    source gives a consumption. No consumption-vs-speed law is assumed. The bunker
+    price is NOT in the canonical files; it is an explicit assumption below.
+
+Not modelled (no source): cargo-handling time, slack time of vessels in a weekly
+schedule, weather, canal fees/draft limits (blank fees are unknown, not zero).
+"""
+
+from __future__ import annotations
+
+import math
+from dataclasses import dataclass, field
+from typing import Dict, List, Optional, Sequence, Tuple
+
+from src.services.service_feasibility import (
+    PortTimeAssumptions,
+    ServiceFeasibility,
+    evaluate_rotation,
+    required_vessels,
+)
+
+DAYS_PER_WEEK = 7.0
+HOURS_PER_DAY = 24.0
+
+
+@dataclass(frozen=True)
+class EconomicsAssumptions:
+    """Explicit modelling assumptions that the canonical files do not supply."""
+
+    port_stay_hours: float = 24.0
+    transshipment_min_hours: float = 48.0
+    transfer_wait_days: float = 3.5
+    bunker_price_usd_per_t: float = 600.0
+    # IP-2 weather adjustment of the sailing speed (1.0 = none); clamped by callers.
+    speed_factor: float = 1.0
+    basis: str = (
+        "assumed (not in the canonical WorldSmall files): LINERLIB benchmark "
+        "documentation gives a minimum port stay of 24 h, a minimum transshipment "
+        "time of 48 h and a bunker cost of 600 USD/t. transfer_wait_days is the "
+        "expected wait for a connecting weekly departure (half a week)."
+    )
+
+    def __post_init__(self):
+        for name in ("port_stay_hours", "transshipment_min_hours", "transfer_wait_days",
+                     "bunker_price_usd_per_t"):
+            v = getattr(self, name)
+            if not (isinstance(v, (int, float)) and math.isfinite(v) and v >= 0):
+                raise ValueError(f"{name} must be a finite number >= 0, got {v!r}")
+        sf = self.speed_factor
+        if not (isinstance(sf, (int, float)) and math.isfinite(sf) and sf > 0):
+            raise ValueError(f"speed_factor must be a finite number > 0, got {sf!r}")
+
+    @property
+    def port_time(self) -> PortTimeAssumptions:
+        return PortTimeAssumptions(self.port_stay_hours)
+
+    @property
+    def port_stay_days(self) -> float:
+        return self.port_stay_hours / HOURS_PER_DAY
+
+    @property
+    def transfer_dwell_days(self) -> float:
+        """Time a container spends at a transshipment hub (minimum handling + wait)."""
+        return self.transshipment_min_hours / HOURS_PER_DAY + self.transfer_wait_days
+
+
+DEFAULT_ASSUMPTIONS = EconomicsAssumptions()
+
+
+class ServiceModelError(ValueError):
+    """The service cannot be modelled (missing class, distance, spec ...)."""
+
+    def __init__(self, message: str, reasons: Sequence[str] = ()):
+        super().__init__(message)
+        self.reasons = list(reasons)
+
+
+@dataclass(frozen=True)
+class ServiceModel:
+    """Everything about one candidate service that does not depend on cargo."""
+
+    service_id: str
+    vessel_class: str
+    ports: Tuple[str, ...]                      # unique rotation order
+    legs: Tuple[Tuple[str, str, float], ...]    # (from, to, nm); closing leg last
+    leg_sail_days: Tuple[float, ...]
+    capacity_teu: float
+    speed_knots: float
+    sea_days: float
+    port_days: float
+    cycle_days: float                           # exact
+    cycle_time_days: int                        # declared = ceil(cycle_days)
+    class_inventory: int
+    vessel_week_cost: float                     # TC_daily * 7, per vessel
+    fuel_cost_per_rotation: float               # USD, sea + port idle
+    fuel_tonnes_per_rotation: float
+    port_fixed_per_rotation: float              # sum of fixed port-call costs
+    capacity_unit_status: str = "provisional"
+
+    # ---- time/vessel relations -------------------------------------------------
+    def vessels(self, departures_per_week: int) -> int:
+        """Vessels needed for ``departures_per_week`` (0 departures -> 0 vessels)."""
+        return required_vessels(self.cycle_time_days, departures_per_week)
+
+    def max_departures(self, vessel_budget: Optional[int] = None) -> int:
+        """Largest weekly frequency the class inventory can sustain for this rotation
+        (``floor(7 * N / T)``); ``vessel_budget`` caps N below the class inventory."""
+        n = self.class_inventory if vessel_budget is None else min(vessel_budget, self.class_inventory)
+        return int(math.floor(round(DAYS_PER_WEEK * n / self.cycle_time_days, 9)))
+
+    def departure_interval_days(self, departures_per_week: int) -> float:
+        if departures_per_week <= 0:
+            raise ValueError("no departures")
+        return DAYS_PER_WEEK / departures_per_week
+
+    # ---- weekly economics --------------------------------------------------------
+    def weekly_vessel_cost(self, f: int) -> float:
+        return self.vessels(f) * self.vessel_week_cost
+
+    def weekly_fuel_cost(self, f: int) -> float:
+        return f * self.fuel_cost_per_rotation
+
+    def weekly_port_fixed_cost(self, f: int) -> float:
+        return f * self.port_fixed_per_rotation
+
+    def weekly_fixed_cost(self, f: int) -> float:
+        return self.weekly_vessel_cost(f) + self.weekly_fuel_cost(f) + self.weekly_port_fixed_cost(f)
+
+    def weekly_leg_capacity(self, f: int) -> float:
+        return self.capacity_teu * f
+
+    # ---- geometry -------------------------------------------------------------------
+    def position(self, port: str) -> Optional[int]:
+        try:
+            return self.ports.index(port)
+        except ValueError:
+            return None
+
+    def ride(self, a: str, b: str) -> Optional[Tuple[Tuple[int, ...], float]]:
+        """Leg indices and transit days when riding the closed rotation from ``a`` to
+        ``b`` (forward, wrapping around). Transit = sailing + one port stay at each
+        INTERMEDIATE port; time at the origin and at the destination is not counted."""
+        ia, ib = self.position(a), self.position(b)
+        if ia is None or ib is None or ia == ib:
+            return None
+        n = len(self.ports)
+        legs, days, i = [], 0.0, ia
+        while i != ib:
+            legs.append(i)
+            days += self.leg_sail_days[i]
+            i = (i + 1) % n
+            if i != ib:
+                days += self._port_stay_days
+        return tuple(legs), days
+
+    # filled by build_service_model (frozen dataclass -> set through object.__setattr__)
+    _port_stay_days: float = 1.0
+
+
+def _port_attr(port, name: str) -> float:
+    v = getattr(port, name, 0.0) if port is not None else 0.0
+    return float(v) if isinstance(v, (int, float)) and math.isfinite(v) else 0.0
+
+
+def build_service_model(
+    service_id: str,
+    route: Sequence[str],
+    vessel,
+    distance_matrix: Dict,
+    port_lookup: Dict,
+    assumptions: EconomicsAssumptions = DEFAULT_ASSUMPTIONS,
+    *,
+    known_ports=None,
+    capacity_unit_status: str = "provisional",
+) -> ServiceModel:
+    """Build the model of one candidate; raise ``ServiceModelError`` if it cannot be
+    evaluated (never substituting a value)."""
+    feas: ServiceFeasibility = evaluate_rotation(
+        route, vessel, distance_matrix,
+        known_ports=known_ports, port_time=assumptions.port_time,
+        capacity_unit_status=capacity_unit_status,
+    )
+    if not feas.feasible:
+        raise ServiceModelError(
+            f"service {service_id}: {', '.join(feas.reasons)}: {'; '.join(feas.details)}",
+            feas.reasons,
+        )
+    for fld in ("bunker_consumption_tons_per_day", "idle_consumption_tons_per_day", "tc_rate_daily"):
+        val = getattr(vessel, fld, None)
+        if not (isinstance(val, (int, float)) and math.isfinite(val) and val >= 0):
+            raise ServiceModelError(
+                f"service {service_id}: vessel class {vessel.vessel_class!r} has no valid {fld} ({val!r})",
+                ["missing_fleet_parameter"],
+            )
+
+    missing_ports = [p for p in feas.ports if p not in port_lookup]
+    if missing_ports:
+        raise ServiceModelError(
+            f"service {service_id}: no port record for {missing_ports}; port costs are "
+            f"never assumed to be zero", ["missing_port_record"])
+
+    speed = feas.speed_knots * assumptions.speed_factor
+    leg_days = tuple(nm / (speed * HOURS_PER_DAY) for _, _, nm in feas.legs)
+    sea_days = sum(leg_days)
+    port_days = len(feas.ports) * assumptions.port_stay_days
+    fuel_t = sea_days * vessel.bunker_consumption_tons_per_day \
+        + port_days * vessel.idle_consumption_tons_per_day
+    port_fixed = sum(_port_attr(port_lookup.get(p), "port_call_cost") for p in feas.ports)
+
+    m = ServiceModel(
+        service_id=str(service_id),
+        vessel_class=vessel.vessel_class,
+        ports=tuple(feas.ports),
+        legs=tuple(feas.legs),
+        leg_sail_days=leg_days,
+        capacity_teu=float(vessel.capacity_teu),
+        speed_knots=float(speed),
+        sea_days=sea_days,
+        port_days=port_days,
+        cycle_days=sea_days + port_days,
+        cycle_time_days=int(math.ceil(round(sea_days + port_days, 9))),
+        class_inventory=int(vessel.quantity),
+        vessel_week_cost=float(vessel.tc_rate_daily) * DAYS_PER_WEEK,
+        fuel_cost_per_rotation=fuel_t * assumptions.bunker_price_usd_per_t,
+        fuel_tonnes_per_rotation=fuel_t,
+        port_fixed_per_rotation=port_fixed,
+        capacity_unit_status=capacity_unit_status,
+        _port_stay_days=assumptions.port_stay_days,
+    )
+    return m
+
+
+def estimate_best_frequency(model: ServiceModel, demand_teu: float,
+                            avg_revenue_per_teu: float, vessel_budget: Optional[int] = None) -> Tuple[int, float]:
+    """Surrogate used by the GAs: the weekly frequency maximising
+    ``min(cap*f, demand) * revenue - weekly_fixed_cost(f)`` (0 if unprofitable).
+    Returns ``(f, margin)``. Not verified profit - the network MILP/ledger decide."""
+    fmax = model.max_departures(vessel_budget)
+    if fmax <= 0 or demand_teu <= 0:
+        return 0, 0.0
+    f_demand = max(1, int(math.ceil(demand_teu / model.capacity_teu)))
+    best_f, best_m = 0, 0.0
+    for f in range(1, min(fmax, f_demand) + 1):
+        margin = min(model.capacity_teu * f, demand_teu) * avg_revenue_per_teu - model.weekly_fixed_cost(f)
+        if margin > best_m:
+            best_f, best_m = f, margin
+    return best_f, best_m
+
+
+# =====================================================================================
+# Per-problem helpers shared by the GA stages, the regional MILP and the global stage
+# =====================================================================================
+def assumptions_for_problem(problem, base: EconomicsAssumptions = DEFAULT_ASSUMPTIONS) -> EconomicsAssumptions:
+    """``base`` with the IP-2 weather speed factor from attached maritime features
+    (clamped to [0.5, 1.5]); unchanged when none is attached."""
+    mf = getattr(problem, "maritime_features", None)
+    wsf = getattr(mf, "weather_speed_factor", None) if mf is not None else None
+    if not isinstance(wsf, (int, float)) or isinstance(wsf, bool) \
+            or not math.isfinite(wsf):
+        return base
+    wsf = min(1.5, max(0.5, float(wsf)))
+    if wsf == base.speed_factor:
+        return base
+    return EconomicsAssumptions(**{**base.__dict__, "speed_factor": wsf})
+
+
+def service_models_for(problem, assumptions: Optional[EconomicsAssumptions] = None) -> List[Optional[ServiceModel]]:
+    """One ``ServiceModel`` per entry of ``problem.services`` (``None`` where the
+    service cannot be modelled: no fleet, unknown class, missing distance or port
+    record). Cached on the problem object and rebuilt when the service list, fleet
+    or assumptions change."""
+    assumptions = assumptions or assumptions_for_problem(problem)
+    fleet = getattr(problem, "fleet", None)
+    services = problem.services
+    key = (id(services), len(services), id(fleet), assumptions)
+    cache = getattr(problem, "_service_models_cache", None)
+    if cache is not None and cache[0] == key:
+        return cache[1]
+    if fleet is None or not getattr(fleet, "classes", None):
+        models: List[Optional[ServiceModel]] = [None] * len(services)
+    else:
+        catalog = getattr(problem, "port_catalog", None)
+        port_lookup = dict(catalog) if catalog else {p.id: p for p in problem.ports}
+        known = set(problem.distance_matrix)
+        status = getattr(fleet, "capacity_unit_status", "provisional")
+        models = []
+        for svc in services:
+            vessel = fleet.get_class(svc.vessel_class) if getattr(svc, "vessel_class", "") else None
+            try:
+                models.append(build_service_model(
+                    str(svc.id), svc.ports, vessel, problem.distance_matrix, port_lookup,
+                    assumptions, known_ports=known, capacity_unit_status=status))
+            except ServiceModelError:
+                models.append(None)
+    try:
+        problem._service_models_cache = (key, models)
+    except Exception:                                              # noqa: BLE001
+        pass
+    return models
diff --git a/src/network/ledger.py b/src/network/ledger.py
new file mode 100644
index 0000000..a936d40
--- /dev/null
+++ b/src/network/ledger.py
@@ -0,0 +1,306 @@
+"""Independent accounting ledger and network validator.
+
+Given only (a) which services operate at which weekly frequency and (b) how many
+TEU of each OD were carried on which sequence of service segments, this module
+recomputes - from the raw distance matrix, fleet records and port records, WITHOUT
+using the service model or the MILP that produced the plan - the full economics and
+checks every constraint. It is the authority that decides whether a result may be
+reported as verified.
+
+Accounting identity (USD per week)
+
+    operating_profit = cargo_revenue
+                     - vessel_cost            N_s * TC_daily * 7
+                     - fuel_cost              f_s * (sea_days*bunker_t + port_days*idle_t) * price
+                     - port_call_fixed_cost   f_s * sum(PortCallCostFixed over calls)
+                     - handling_cost          origin load + destination unload, per TEU
+                     - transshipment_cost     per TEU at the hub
+                     - port_variable_cost     per TEU per load/unload event
+    cargo_revenue    = sum_allocations teu * revenue_per_teu(od)        (once per OD TEU)
+
+Penalties or rewards used by an optimiser never appear here.
+"""
+
+from __future__ import annotations
+
+import math
+from collections import defaultdict
+from dataclasses import dataclass, field
+from typing import Dict, List, Optional, Sequence, Tuple
+
+TOL = 1e-6
+
+
+@dataclass(frozen=True)
+class LedgerService:
+    service_id: str
+    ports: Tuple[str, ...]
+    vessel_class: str
+    frequency: int                   # departures per week
+
+
+@dataclass(frozen=True)
+class LedgerFlow:
+    od: int                          # index into the demand list
+    segments: Tuple[Tuple[str, str, str], ...]   # (service_id, from_port, to_port)
+    teu: float
+
+
+@dataclass
+class Ledger:
+    revenue: float = 0.0
+    vessel_cost: float = 0.0
+    fuel_cost: float = 0.0
+    port_call_fixed_cost: float = 0.0
+    handling_cost: float = 0.0
+    transshipment_cost: float = 0.0
+    port_variable_cost: float = 0.0
+    served_teu: float = 0.0
+    unserved_teu: float = 0.0
+    total_demand_teu: float = 0.0
+    vessels_by_class: Dict[str, int] = field(default_factory=dict)
+    vessels_by_service: Dict[str, int] = field(default_factory=dict)
+    cycle_time_days: Dict[str, int] = field(default_factory=dict)
+    service_rows: Dict[str, Dict] = field(default_factory=dict)
+    od_served: Dict[int, float] = field(default_factory=dict)
+    violations: List[Dict] = field(default_factory=list)
+
+    @property
+    def operating_cost(self) -> float:
+        return (self.vessel_cost + self.fuel_cost + self.port_call_fixed_cost
+                + self.handling_cost + self.transshipment_cost + self.port_variable_cost)
+
+    @property
+    def operating_profit(self) -> float:
+        return self.revenue - self.operating_cost
+
+    @property
+    def coverage(self) -> float:
+        return self.served_teu / self.total_demand_teu if self.total_demand_teu > 0 else 0.0
+
+    @property
+    def valid(self) -> bool:
+        return not self.violations
+
+    def to_dict(self) -> Dict:
+        return {
+            "revenue": self.revenue, "vessel_cost": self.vessel_cost, "fuel_cost": self.fuel_cost,
+            "port_call_fixed_cost": self.port_call_fixed_cost, "handling_cost": self.handling_cost,
+            "transshipment_cost": self.transshipment_cost, "port_variable_cost": self.port_variable_cost,
+            "operating_cost": self.operating_cost, "operating_profit": self.operating_profit,
+            "served_teu": self.served_teu, "unserved_teu": self.unserved_teu,
+            "total_demand_teu": self.total_demand_teu, "coverage": self.coverage,
+            "vessels_by_class": dict(self.vessels_by_class),
+            "valid": self.valid, "violations": list(self.violations),
+        }
+
+
+def _num(x, default=0.0) -> float:
+    return float(x) if isinstance(x, (int, float)) and math.isfinite(x) else default
+
+
+def compute_ledger(
+    services: Sequence[LedgerService],
+    flows: Sequence[LedgerFlow],
+    demands: Sequence,
+    fleet,
+    distance_matrix: Dict,
+    port_lookup: Dict,
+    *,
+    port_stay_hours: float,
+    transshipment_min_hours: float,
+    transfer_wait_days: float,
+    bunker_price_usd_per_t: float,
+    unserved_reported: Optional[Dict[int, float]] = None,
+    speed_factor: float = 1.0,
+) -> Ledger:
+    """Recompute the economics of a plan and validate it. Never raises for a bad
+    plan: every problem is a structured violation."""
+    L = Ledger()
+    bad = L.violations.append
+    stay_days = port_stay_hours / 24.0
+    dwell_days = transshipment_min_hours / 24.0 + transfer_wait_days
+
+    # ---- services: rotation, time, vessels, fixed costs ----------------------------
+    svc: Dict[str, Dict] = {}
+    for s in services:
+        if s.service_id in svc:
+            bad({"type": "duplicate_service", "service": s.service_id})
+            continue
+        f = s.frequency
+        if not isinstance(f, int) or isinstance(f, bool) or f < 0:
+            bad({"type": "invalid_frequency", "service": s.service_id, "value": f})
+            continue
+        cls = fleet.get_class(s.vessel_class) if fleet is not None else None
+        if cls is None:
+            bad({"type": "unknown_vessel_class", "service": s.service_id, "class": s.vessel_class})
+            continue
+        ports = list(s.ports)
+        if len(ports) >= 2 and ports[0] == ports[-1]:
+            ports = ports[:-1]
+        if len(ports) < 2 or len(set(ports)) != len(ports):
+            bad({"type": "invalid_route", "service": s.service_id, "ports": list(s.ports)})
+            continue
+        legs, missing = [], False
+        for i, a in enumerate(ports):
+            b = ports[(i + 1) % len(ports)]
+            d = (distance_matrix.get(a) or {}).get(b)
+            if not (isinstance(d, (int, float)) and math.isfinite(d) and d > 0):
+                bad({"type": "missing_distance", "service": s.service_id, "leg": (a, b)})
+                missing = True
+                break
+            legs.append(float(d))
+        if missing:
+            continue
+        absent = [p for p in ports if p not in port_lookup]
+        if absent:
+            bad({"type": "missing_port_record", "service": s.service_id, "ports": absent})
+            continue
+        speed = cls.design_speed * speed_factor
+        leg_days = [d / (speed * 24.0) for d in legs]
+        sea_days = sum(leg_days)
+        port_days = len(ports) * stay_days
+        cycle = math.ceil(round(sea_days + port_days, 9))
+        vessels = 0 if f == 0 else math.ceil(round(cycle * f / 7.0, 9))
+        svc[s.service_id] = {
+            "ports": ports, "class": cls, "f": f, "leg_days": leg_days, "cycle": cycle,
+            "vessels": vessels, "cap": float(cls.capacity_teu),
+            "vessel_cost": vessels * cls.tc_rate_daily * 7.0,
+            "fuel": f * (sea_days * cls.bunker_consumption_tons_per_day
+                         + port_days * cls.idle_consumption_tons_per_day) * bunker_price_usd_per_t,
+            "port_fixed": f * sum(_num(getattr(port_lookup.get(p), "port_call_cost", 0.0)) for p in ports),
+            "revenue": 0.0, "load": 0.0, "var_cost": 0.0,
+        }
+        L.cycle_time_days[s.service_id] = cycle
+        L.vessels_by_service[s.service_id] = vessels
+        L.vessels_by_class[cls.vessel_class] = L.vessels_by_class.get(cls.vessel_class, 0) + vessels
+        L.vessel_cost += svc[s.service_id]["vessel_cost"]
+        L.fuel_cost += svc[s.service_id]["fuel"]
+        L.port_call_fixed_cost += svc[s.service_id]["port_fixed"]
+
+    # fleet inventory per class
+    for cname, used in L.vessels_by_class.items():
+        avail = fleet.quantity_of(cname)
+        if used > avail:
+            bad({"type": "fleet_exceeded", "class": cname, "used": used, "available": avail,
+                 "excess": used - avail})
+
+    # ---- flows: revenue, per-TEU charges, leg loads, transit --------------------
+    leg_load: Dict[Tuple[str, int], float] = defaultdict(float)
+    served: Dict[int, float] = defaultdict(float)
+    for fl in flows:
+        if not (isinstance(fl.teu, (int, float)) and math.isfinite(fl.teu) and fl.teu >= 0):
+            bad({"type": "invalid_flow", "od": fl.od, "teu": fl.teu})
+            continue
+        if fl.teu <= TOL:
+            continue
+        if not 0 <= fl.od < len(demands):
+            bad({"type": "unknown_od", "od": fl.od})
+            continue
+        d = demands[fl.od]
+        segs = fl.segments
+        if not segs or len(segs) > 2:
+            bad({"type": "invalid_path", "od": fl.od, "detail": "needs 1 or 2 segments"})
+            continue
+        if segs[0][1] != d.origin or segs[-1][2] != d.destination:
+            bad({"type": "invalid_path", "od": fl.od,
+                 "detail": f"path {segs[0][1]}->{segs[-1][2]} does not connect {d.origin}->{d.destination}"})
+            continue
+        if len(segs) == 2 and segs[0][2] != segs[1][1]:
+            bad({"type": "invalid_transfer", "od": fl.od,
+                 "detail": f"arrives {segs[0][2]}, next departs {segs[1][1]}"})
+            continue
+
+        transit, ride_days, path_ok = 0.0, [], True
+        for k, (sid, a, b) in enumerate(segs):
+            s = svc.get(sid)
+            if s is None or s["f"] <= 0:
+                bad({"type": "flow_on_inactive_service", "od": fl.od, "service": sid})
+                path_ok = False
+                break
+            ports = s["ports"]
+            if a not in ports or b not in ports or a == b:
+                bad({"type": "invalid_route", "od": fl.od, "service": sid,
+                     "detail": f"{a}->{b} not on rotation {ports}"})
+                path_ok = False
+                break
+            i, j, n = ports.index(a), ports.index(b), len(ports)
+            days, idx = 0.0, i
+            while idx != j:
+                leg_load[(sid, idx)] += fl.teu
+                days += s["leg_days"][idx]
+                idx = (idx + 1) % n
+                if idx != j:
+                    days += stay_days
+            ride_days.append(days)
+            transit += days
+        if not path_ok:
+            continue
+        if len(segs) == 2:
+            transit += dwell_days
+        limit = getattr(d, "max_transit_days", None)
+        if limit is not None and transit > limit + 1e-9:
+            bad({"type": "transit_time_exceeded", "od": fl.od, "transit_days": transit, "limit_days": limit})
+
+        o, t = port_lookup.get(d.origin), port_lookup.get(d.destination)
+        if o is None or t is None or (len(segs) == 2 and port_lookup.get(segs[0][2]) is None):
+            bad({"type": "missing_port_record", "od": fl.od})
+            continue
+        L.revenue += fl.teu * d.revenue_per_teu
+        L.handling_cost += fl.teu * (_num(getattr(o, "handling_cost", 0.0)) + _num(getattr(t, "handling_cost", 0.0)))
+        L.port_variable_cost += fl.teu * (_num(getattr(o, "variable_port_call_cost", 0.0))
+                                          + _num(getattr(t, "variable_port_call_cost", 0.0)))
+        path_var = (_num(getattr(o, "handling_cost", 0.0)) + _num(getattr(t, "handling_cost", 0.0))
+                    + _num(getattr(o, "variable_port_call_cost", 0.0))
+                    + _num(getattr(t, "variable_port_call_cost", 0.0)))
+        if len(segs) == 2:
+            h = port_lookup.get(segs[0][2])
+            L.transshipment_cost += fl.teu * _num(getattr(h, "transshipment_cost", 0.0))
+            L.port_variable_cost += fl.teu * 2.0 * _num(getattr(h, "variable_port_call_cost", 0.0))
+            path_var += (_num(getattr(h, "transshipment_cost", 0.0))
+                         + 2.0 * _num(getattr(h, "variable_port_call_cost", 0.0)))
+        served[fl.od] += fl.teu
+        # attribution only (totals above are what count): split by ride days
+        tot = sum(ride_days) or 1.0
+        for (sid, _a, _b), rd in zip(segs, ride_days):
+            share = rd / tot
+            row = svc[sid]
+            row["revenue"] += fl.teu * d.revenue_per_teu * share
+            row["load"] += fl.teu * share if len(segs) == 1 else fl.teu
+            row["var_cost"] += fl.teu * path_var * share
+
+    # ---- leg capacity ---------------------------------------------------------------
+    for (sid, leg), load in leg_load.items():
+        cap = svc[sid]["cap"] * svc[sid]["f"]
+        if load > cap + 1e-6 * max(1.0, cap):
+            a = svc[sid]["ports"][leg]
+            b = svc[sid]["ports"][(leg + 1) % len(svc[sid]["ports"])]
+            bad({"type": "leg_capacity_exceeded", "service": sid, "leg": (a, b),
+                 "load": load, "capacity": cap, "excess": load - cap})
+
+    # ---- demand conservation --------------------------------------------------------
+    for di, d in enumerate(demands):
+        if not d.weekly_teu > 0:
+            continue
+        L.total_demand_teu += d.weekly_teu
+        s_teu = served.get(di, 0.0)
+        L.od_served[di] = s_teu
+        if s_teu > d.weekly_teu + 1e-6 * max(1.0, d.weekly_teu):
+            bad({"type": "demand_overserved", "od": di, "served": s_teu, "demand": d.weekly_teu})
+        if unserved_reported is not None and di in unserved_reported:
+            if abs(s_teu + unserved_reported[di] - d.weekly_teu) > 1e-5 * max(1.0, d.weekly_teu):
+                bad({"type": "demand_not_conserved", "od": di, "served": s_teu,
+                     "unserved": unserved_reported[di], "demand": d.weekly_teu})
+    L.served_teu = sum(min(L.od_served.get(di, 0.0), d.weekly_teu)
+                       for di, d in enumerate(demands) if d.weekly_teu > 0)
+    L.unserved_teu = max(0.0, L.total_demand_teu - L.served_teu)
+
+    for sid, r in svc.items():
+        L.service_rows[sid] = {
+            "ports": list(r["ports"]), "vessel_class": r["class"].vessel_class,
+            "frequency": r["f"], "vessels": r["vessels"], "cycle_time_days": r["cycle"],
+            "capacity_per_departure": r["cap"], "load": r["load"], "revenue": r["revenue"],
+            "vessel_cost": r["vessel_cost"], "fuel_cost": r["fuel"],
+            "port_cost": r["port_fixed"] + r["var_cost"],
+        }
+    return L
diff --git a/src/network/network_milp.py b/src/network/network_milp.py
new file mode 100644
index 0000000..9e57a86
--- /dev/null
+++ b/src/network/network_milp.py
@@ -0,0 +1,331 @@
+"""Network design MILP over candidate services and OD paths.
+
+Decision variables
+    f_s  integer  weekly departures of service s            (0 = not operated)
+    n_s  integer  vessels deployed on service s
+    q_p  >= 0     TEU/week of OD d routed on path p
+    u_d  >= 0     TEU/week of OD d left unserved
+
+Constraints
+    demand        sum_p q_p + u_d == weekly_teu_d                     (each OD once)
+    leg capacity  sum_{p uses (s,leg)} q_p <= capacity_s * f_s        (EVERY leg)
+    vessels       7 * n_s >= cycle_time_days_s * f_s                  (ceil(T f / 7))
+    fleet         sum_{s in class c} n_s <= vessels available of c    (per class)
+
+Objective (maximise)
+    sum_p (revenue_per_teu_d - port_cost_per_teu_p) q_p
+    - sum_s [ vessel_week_cost_s n_s + (rotation_fuel_s + port_fixed_s) f_s ]
+    - unserved_penalty * sum_d u_d          <- optimisation-only; default 0.0
+
+With ``unserved_penalty = 0`` the objective IS the operating profit. Any penalty is
+reported separately (``objective_components``) and is never part of the ledger.
+Transit-time limits are enforced when paths are built (see ``paths.py``).
+
+Solution method (``lp_guided=True``, default when frequencies are free)
+    1. solve the LP relaxation (f, n continuous): its value is a valid UPPER BOUND
+       on the achievable profit and is reported as ``relaxation_bound``;
+    2. keep only the services the relaxation uses and the paths that use only them,
+       and solve the integer problem on that restriction.
+    The restriction can exclude better integer solutions, so the result is a
+    feasible plan with a stated bound, not a proof of optimality: ``status`` is
+    ``"optimal"`` only if the restricted MILP closed AND no service was dropped.
+"""
+
+from __future__ import annotations
+
+import logging
+import math
+import os
+import time
+from collections import defaultdict
+from dataclasses import dataclass, field
+from typing import Dict, List, Optional, Sequence, Tuple
+
+import pulp
+
+from src.network.economics import ServiceModel
+from src.network.paths import OdPath
+
+logger = logging.getLogger(__name__)
+
+
+@dataclass
+class NetworkSolution:
+    status: str                          # optimal | feasible | infeasible | not_solved | solver_error
+    solver_status: str = ""
+    message: str = ""
+    objective_value: float = 0.0
+    relaxation_bound: Optional[float] = None     # LP upper bound on the objective
+    frequencies: Dict[int, int] = field(default_factory=dict)     # service index -> f
+    vessels: Dict[int, int] = field(default_factory=dict)         # service index -> n
+    flows: List[Tuple[int, int, float]] = field(default_factory=list)  # (od, path#, TEU)
+    unserved: Dict[int, float] = field(default_factory=dict)
+    objective_components: Dict[str, float] = field(default_factory=dict)
+    n_variables: int = 0
+    n_constraints: int = 0
+    n_paths: int = 0
+    n_services_considered: int = 0
+    n_services_restricted_to: int = 0
+    runtime_sec: float = 0.0
+
+    @property
+    def usable(self) -> bool:
+        """A solution whose values may be reported (optimal, or a feasible incumbent)."""
+        return self.status in ("optimal", "feasible")
+
+
+def _solver(time_limit_sec: float, threads: Optional[int], warm: bool):
+    # threads is opt-in: the bundled parallel CBC stalled (idle, ignoring its time
+    # limit) on a 5k-row model, so the default is the single-threaded solver.
+    return pulp.PULP_CBC_CMD(
+        msg=bool(os.environ.get("NETWORK_MILP_LOG")),
+        timeLimit=max(1, int(math.ceil(time_limit_sec))),
+        threads=threads if threads and threads > 1 else None,
+        warmStart=warm,
+    )
+
+
+def _build_and_solve(
+    models, demands, paths_by_od, limits, services: Sequence[int], *, integer: bool,
+    penalty: float, fixed: Optional[Dict[int, int]], initial: Optional[Dict[int, int]],
+    max_departures_cap: Optional[int], time_limit_sec: float, threads: Optional[int],
+    total_vessel_limit: Optional[int] = None,
+    port_capacity: Optional[Dict[str, float]] = None,
+    min_served_fraction: Optional[float] = None,
+):
+    """Build the model over ``services`` (indices) and solve it. Returns a dict with
+    the PuLP problem, variables and statuses; raises nothing for solver outcomes."""
+    keep = set(services)
+    # only paths whose every segment service is kept
+    sub_paths: Dict[int, List[Tuple[int, OdPath]]] = {}
+    used: Dict[int, float] = defaultdict(float)
+    for di, plist in paths_by_od.items():
+        kept = [(k, p) for k, p in enumerate(plist) if all(s in keep for s in p.services)]
+        if kept:
+            sub_paths[di] = kept
+            for _, p in kept:
+                for si in p.services:
+                    used[si] += demands[di].weekly_teu
+    active = sorted(used)
+
+    prob = pulp.LpProblem("NetworkDesign", pulp.LpMaximize)
+    cat = "Integer" if integer else "Continuous"
+    f: Dict[int, pulp.LpVariable] = {}
+    n: Dict[int, pulp.LpVariable] = {}
+    for si in active:
+        m = models[si]
+        limit = int(limits.get(m.vessel_class, m.class_inventory))
+        ub = m.max_departures(limit)
+        if max_departures_cap is not None:
+            ub = min(ub, int(max_departures_cap))
+        ub = min(ub, max(1, int(math.ceil(used[si] / m.capacity_teu))))
+        if fixed is not None:
+            # imposed exactly; an unsustainable frequency makes the fleet constraint
+            # infeasible (explicit status) - it is never silently clipped
+            lb = ub = max(0, int(fixed.get(si, 0)))
+        else:
+            lb = 0
+        f[si] = pulp.LpVariable(f"f_{si}", lowBound=lb, upBound=max(ub, 0), cat=cat)
+        n[si] = pulp.LpVariable(f"n_{si}", lowBound=0, upBound=max(limit, 0), cat=cat)
+        if integer and initial and si in initial:
+            f0 = min(max(int(initial[si]), lb), max(ub, 0))
+            f[si].setInitialValue(f0)
+            n[si].setInitialValue(m.vessels(f0))
+
+    q: Dict[Tuple[int, int], pulp.LpVariable] = {}
+    for di, kept in sub_paths.items():
+        for k, _ in kept:
+            q[(di, k)] = pulp.LpVariable(f"q_{di}_{k}", lowBound=0)
+    u = {di: pulp.LpVariable(f"u_{di}", lowBound=0)
+         for di, d in enumerate(demands) if d.weekly_teu > 0}
+
+    path_of = {(di, k): p for di, kept in sub_paths.items() for k, p in kept}
+    revenue = pulp.lpSum(demands[di].revenue_per_teu * v for (di, k), v in q.items())
+    per_teu_port = pulp.lpSum(path_of[(di, k)].port_cost_per_teu * v for (di, k), v in q.items())
+    vessel_cost = pulp.lpSum(models[si].vessel_week_cost * n[si] for si in active)
+    fuel_cost = pulp.lpSum(models[si].fuel_cost_per_rotation * f[si] for si in active)
+    port_fixed = pulp.lpSum(models[si].port_fixed_per_rotation * f[si] for si in active)
+    pen = penalty * pulp.lpSum(u.values())
+    prob += revenue - per_teu_port - vessel_cost - fuel_cost - port_fixed - pen
+
+    for di, d in enumerate(demands):
+        if d.weekly_teu > 0:
+            prob += (
+                pulp.lpSum(q[(di, k)] for k, _ in sub_paths.get(di, ())) + u[di]
+                == d.weekly_teu
+            ), f"dem_{di}"
+    leg_load: Dict[Tuple[int, int], List[pulp.LpVariable]] = defaultdict(list)
+    for (di, k), v in q.items():
+        for seg in path_of[(di, k)].segments:
+            for leg in seg.legs:
+                leg_load[(seg.service, leg)].append(v)
+    for (si, leg), vs in leg_load.items():
+        prob += pulp.lpSum(vs) <= models[si].capacity_teu * f[si], f"cap_{si}_{leg}"
+    for si in active:
+        prob += 7 * n[si] >= models[si].cycle_time_days * f[si], f"veh_{si}"
+    by_class: Dict[str, List[int]] = defaultdict(list)
+    for si in active:
+        by_class[models[si].vessel_class].append(si)
+    for cls, sis in by_class.items():
+        limit = int(limits.get(cls, models[sis[0]].class_inventory))
+        prob += pulp.lpSum(n[si] for si in sis) <= limit, f"fleet_{cls}"
+    if total_vessel_limit is not None and active:
+        prob += pulp.lpSum(n[si] for si in active) <= int(total_vessel_limit), "fleet_total"
+    if port_capacity:
+        events: Dict[str, List[Tuple[pulp.LpVariable, float]]] = defaultdict(list)
+        for (di, k), v in q.items():
+            pth = path_of[(di, k)]
+            events[pth.segments[0].from_port].append((v, 1.0))
+            events[pth.segments[-1].to_port].append((v, 1.0))
+            if pth.hub is not None:
+                events[pth.hub].append((v, 2.0))
+        for port, terms in events.items():
+            if port in port_capacity:
+                prob += (pulp.lpSum(c * v for v, c in terms) <= float(port_capacity[port]),
+                         f"port_{port}")
+    if min_served_fraction and q:
+        total = sum(d.weekly_teu for d in demands if d.weekly_teu > 0)
+        prob += pulp.lpSum(q.values()) >= float(min_served_fraction) * total, "min_coverage"
+
+    out = dict(prob=prob, f=f, n=n, q=q, u=u, active=active, terms=dict(
+        revenue=revenue, per_teu_port=per_teu_port, vessel_cost=vessel_cost,
+        fuel_cost=fuel_cost, port_fixed=port_fixed, pen=pen), status=None, error=None)
+    if not q:
+        return out
+    try:
+        prob.solve(_solver(time_limit_sec, threads, bool(integer and initial)))
+    except Exception as exc:                                   # noqa: BLE001
+        out["error"] = f"{type(exc).__name__}: {exc}"
+    return out
+
+
+def solve_network(
+    models: Sequence[ServiceModel],
+    demands: Sequence,
+    paths_by_od: Dict[int, List[OdPath]],
+    class_vessel_limit: Dict[str, int],
+    *,
+    unserved_penalty_per_teu: float = 0.0,
+    fixed_frequencies: Optional[Dict[int, int]] = None,
+    initial_frequencies: Optional[Dict[int, int]] = None,
+    max_departures_cap: Optional[int] = None,
+    time_limit_sec: float = 120.0,
+    lp_guided: Optional[bool] = None,
+    lp_keep_threshold: float = 1e-6,
+    threads: Optional[int] = None,
+    total_vessel_limit: Optional[int] = None,
+    port_capacity: Optional[Dict[str, float]] = None,
+    min_served_fraction: Optional[float] = None,
+) -> NetworkSolution:
+    """Solve the network design problem. Never raises for solver outcomes: the
+    status field says what happened and ``usable`` says whether values may be used."""
+    t0 = time.perf_counter()
+    if unserved_penalty_per_teu < 0 or not math.isfinite(unserved_penalty_per_teu):
+        raise ValueError("unserved_penalty_per_teu must be a finite number >= 0")
+
+    referenced = sorted({s for plist in paths_by_od.values() for p in plist for s in p.services})
+    sol = NetworkSolution(status="not_solved", n_services_considered=len(referenced),
+                          n_paths=sum(len(v) for v in paths_by_od.values()))
+    if not referenced:        # nothing can be carried: every OD stays unserved (explicit, valid)
+        sol.status, sol.solver_status = "optimal", "no_paths"
+        sol.unserved = {di: float(d.weekly_teu) for di, d in enumerate(demands) if d.weekly_teu > 0}
+        pen_total = unserved_penalty_per_teu * sum(sol.unserved.values())
+        sol.objective_value = -pen_total
+        sol.objective_components = {
+            "revenue": 0.0, "per_teu_port_cost": 0.0, "vessel_cost": 0.0,
+            "fuel_cost": 0.0, "port_fixed_cost": 0.0, "unserved_penalty": pen_total,
+        }
+        sol.relaxation_bound = -pen_total
+        sol.runtime_sec = time.perf_counter() - t0
+        return sol
+
+    if lp_guided is None:
+        lp_guided = fixed_frequencies is None
+    services = referenced
+    dropped = False
+    budget = max(1.0, time_limit_sec)
+
+    # ---- phase 1: LP relaxation (bound + service restriction) -----------------------
+    if lp_guided and fixed_frequencies is None:
+        lp = _build_and_solve(models, demands, paths_by_od, class_vessel_limit, referenced,
+                              integer=False, penalty=unserved_penalty_per_teu, fixed=None,
+                              initial=None, max_departures_cap=max_departures_cap,
+                              time_limit_sec=min(60.0, budget * 0.4), threads=threads,
+                              total_vessel_limit=total_vessel_limit,
+                              port_capacity=port_capacity,
+                              min_served_fraction=min_served_fraction)
+        if lp["error"] or lp["prob"].status != pulp.LpStatusOptimal:
+            lp_guided = False        # fall back to the unrestricted integer solve
+        else:
+            sol.relaxation_bound = float(pulp.value(lp["prob"].objective) or 0.0)
+            used = [si for si in lp["active"] if (lp["f"][si].varValue or 0.0) > lp_keep_threshold]
+            dropped = len(used) < len(lp["active"])
+            services = used
+            sol.n_services_restricted_to = len(used)
+            if not used:
+                # the relaxation operates nothing: the empty network is the answer
+                sol.status, sol.solver_status = "optimal", "lp_operates_nothing"
+                sol.unserved = {di: float(d.weekly_teu) for di, d in enumerate(demands) if d.weekly_teu > 0}
+                pen_total = unserved_penalty_per_teu * sum(sol.unserved.values())
+                sol.objective_value = -pen_total
+                sol.objective_components = {
+                    "revenue": 0.0, "per_teu_port_cost": 0.0, "vessel_cost": 0.0,
+                    "fuel_cost": 0.0, "port_fixed_cost": 0.0, "unserved_penalty": pen_total,
+                }
+                sol.runtime_sec = time.perf_counter() - t0
+                return sol
+            budget = max(1.0, time_limit_sec - (time.perf_counter() - t0))
+    if not sol.n_services_restricted_to:
+        sol.n_services_restricted_to = len(services)
+
+    # ---- phase 2: integer problem on the (restricted) service set --------------------
+    res = _build_and_solve(models, demands, paths_by_od, class_vessel_limit, services,
+                           integer=True, penalty=unserved_penalty_per_teu,
+                           fixed=fixed_frequencies, initial=initial_frequencies,
+                           max_departures_cap=max_departures_cap, time_limit_sec=budget,
+                           threads=threads, total_vessel_limit=total_vessel_limit,
+                           port_capacity=port_capacity,
+                           min_served_fraction=min_served_fraction)
+    prob = res["prob"]
+    sol.n_variables = len(res["f"]) + len(res["n"]) + len(res["q"]) + len(res["u"])
+    sol.n_constraints = len(prob.constraints)
+    sol.runtime_sec = time.perf_counter() - t0
+
+    if res["error"]:
+        sol.status, sol.message = "solver_error", res["error"]
+        logger.error("network_milp_solver_error | %s", res["error"])
+        return sol
+    sol.solver_status = pulp.LpStatus.get(prob.status, str(prob.status))
+    if prob.status == pulp.LpStatusInfeasible:
+        sol.status = "infeasible"
+        return sol
+    if prob.status != pulp.LpStatusOptimal:
+        sol.status = "not_solved"
+        sol.message = f"solver status {sol.solver_status}"
+        return sol
+    f, n, q, u = res["f"], res["n"], res["q"], res["u"]
+    if any(v.varValue is None for v in list(f.values()) + list(q.values())):
+        sol.status = "not_solved"
+        sol.message = "solver reported optimal but returned no variable values"
+        return sol
+
+    closed = getattr(prob, "sol_status", 1) == pulp.LpSolutionOptimal
+    sol.status = "optimal" if (closed and not dropped) else "feasible"
+    sol.objective_value = float(pulp.value(prob.objective) or 0.0)
+    sol.frequencies = {si: int(round(f[si].varValue or 0)) for si in res["active"]}
+    sol.vessels = {si: int(round(n[si].varValue or 0)) for si in res["active"]}
+    for (di, k), v in q.items():
+        val = float(v.varValue or 0.0)
+        if val > 1e-9:
+            sol.flows.append((di, k, val))
+    sol.unserved = {di: float(u[di].varValue or 0.0) for di in u}
+    t = res["terms"]
+    sol.objective_components = {
+        "revenue": float(pulp.value(t["revenue"]) or 0.0),
+        "per_teu_port_cost": float(pulp.value(t["per_teu_port"]) or 0.0),
+        "vessel_cost": float(pulp.value(t["vessel_cost"]) or 0.0),
+        "fuel_cost": float(pulp.value(t["fuel_cost"]) or 0.0),
+        "port_fixed_cost": float(pulp.value(t["port_fixed"]) or 0.0),
+        "unserved_penalty": float(pulp.value(t["pen"]) or 0.0),
+    }
+    return sol
