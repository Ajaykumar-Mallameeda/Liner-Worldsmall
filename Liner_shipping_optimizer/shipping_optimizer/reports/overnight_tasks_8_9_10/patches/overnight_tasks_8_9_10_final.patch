+
+def test_adapter_safe_when_no_snapshot(monkeypatch, tmp_path):
+    monkeypatch.setenv("MARITIME_INTELLIGENCE_ENABLED", "1")
+    monkeypatch.setenv("MARITIME_PORT_INTELLIGENCE_ENABLED", "1")
