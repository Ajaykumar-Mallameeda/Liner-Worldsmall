+    from src.optimization.data import Port, Service, Demand
+    ports = [
+        Port(id="A", name="Port A", latitude=0.0, longitude=0.0,
+             handling_cost=10.0, port_call_cost=100.0,
+             variable_port_call_cost=1.0),
