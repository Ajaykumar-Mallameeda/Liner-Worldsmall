+
+
+def test_generate_snapshot_id_format():
+    sid = generate_snapshot_id(dataset="emodnet_vessel_density")
+    parts = sid.split("_")
+    assert parts[0] == "emodnet"
+    assert "T" in parts[1]
+    assert len(parts[2]) == 8
+
+
+def test_write_creates_layout(tmp_path):
