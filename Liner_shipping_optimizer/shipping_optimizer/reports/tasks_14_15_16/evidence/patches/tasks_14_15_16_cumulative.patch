-    def process(self, input_data: Dict[str, Any]) -> Dict[str, Any]:
-        regional_solutions: List[Dict] = input_data["regional_solutions"]
-        iteration: int                 = input_data.get("iteration", 0)
-
-        logger.info(
-            "coordinator_started",
