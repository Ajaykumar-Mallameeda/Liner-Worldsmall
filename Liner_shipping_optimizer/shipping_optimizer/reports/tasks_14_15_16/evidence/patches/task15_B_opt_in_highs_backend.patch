+#: relative MIP gap at which HiGHS's own optimality status is accepted as "optimal" (its
+#: default ``mip_rel_gap``); the gap actually reached is always reported in ``mip_gap``
+HIGHS_OPTIMAL_GAP = 1e-4
+
