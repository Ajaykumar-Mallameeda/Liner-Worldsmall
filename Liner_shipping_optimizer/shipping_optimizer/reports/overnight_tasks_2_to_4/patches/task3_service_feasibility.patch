+        random.seed(12345)
+        np.random.seed(12345)
+        again = ServiceGeneratorAgent(name="t3b", model="none").generate_services(problem)
+        key = lambda p: [(s.ports, s.vessel_class, s.cycle_time, s.capacity) for s in p]
