+# ---------------------------------------------------------------------------
+# 1-3. Explicit WorldSmall paths, missing files, no fallback
+# ---------------------------------------------------------------------------
+class TestPaths:
+    def test_default_paths_are_the_canonical_worldsmall_files(self):
+        expected = {
+            "ports": "ports.csv",
+            "demand": "Demand_WorldSmall_Fixed_Sep.csv",
+            "distance": "dist_dense.csv",
