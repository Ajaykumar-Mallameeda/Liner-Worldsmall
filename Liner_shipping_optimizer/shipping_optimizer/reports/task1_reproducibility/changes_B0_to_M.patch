+        problem = loader.load_problem(p)
+        assert len(problem.ports) == WS_PORTS and len(problem.demands) == WS_DEMAND_ROWS
+        assert problem.fleet is not None and problem.fleet.total_vessels == WS_FLEET_TOTAL
+
