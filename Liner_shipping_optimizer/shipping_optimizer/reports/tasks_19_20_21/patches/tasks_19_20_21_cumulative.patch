+                        slot = (slots.segment(s1, l1) + slots.segment(s2, r2[0])
+                                + slots.segment(s3, l3)) if slots else None
+                        port_c = base_cost + c1 + c2
+                        key = port_c + (slot or 0.0)
+                        out.append((key, OdPath(
