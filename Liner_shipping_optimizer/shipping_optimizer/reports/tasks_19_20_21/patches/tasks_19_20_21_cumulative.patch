+                            segments=(PathSegment(s1, l1, o, h1, d1),
+                                      PathSegment(s2, r2[0], h1, h2, r2[1]),
+                                      PathSegment(s3, l3, h2, t, d3)),
+                            hub=h1, transit_days=total, port_cost_per_teu=port_c,
+                            hubs=(h1, h2), slot_cost_per_teu=slot)))
+    out.sort(key=lambda kp: (kp[0], kp[1].transit_days, kp[1].services, kp[1].hubs))
+    return [p for _, p in out[:cfg.multi_hop_pool_per_od]], over
