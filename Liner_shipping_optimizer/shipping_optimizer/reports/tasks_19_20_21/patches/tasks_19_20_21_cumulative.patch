+        assert p.transit_days == pytest.approx((1000 + 600 + 800) / 288.0 + 2 * DWELL)
+        assert p.port_cost_per_teu == pytest.approx((10 + 1) + (20 + 2) + (40 + 2 * 3) + (50 + 2 * 4))
+        assert st.od_rescued_by_multi_hop == 1 and st.paths_multi_hop_kept == 1
