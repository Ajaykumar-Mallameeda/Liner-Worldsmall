+# ================================================================== E. selection / budgets
+class TestSelection:
+    def _two_direct(self):
+        fleet = Fleet(classes=[vessel("Big", cap=5000.0, tc=10000.0, design=12.0),
+                               vessel("Fast", cap=500.0, tc=20000.0, design=20.0)])
