-            kept = _select_fastest(direct, transfer, cap - n_cost)
-            multi_sorted = sorted(multi, key=lambda p: (p.transit_days, p.port_cost_per_teu))
-            if multi_sorted and len(kept) < cap - n_cost:
-                kept = kept + multi_sorted[:cap - n_cost - len(kept)]
-            have = {(p.services, p.transfer_ports) for p in kept}
