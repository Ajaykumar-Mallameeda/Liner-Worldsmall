+@dataclass(frozen=True)
+class OdPath:
+    od: int                      # index into the demand list
+    kind: str                    # "direct" | "transfer" | "transfer2"
+    segments: Tuple[PathSegment, ...]
+    hub: Optional[str]           # first transfer port (None for a direct path)
+    transit_days: float
+    port_cost_per_teu: float     # all per-TEU port charges on this path
+    hubs: Tuple[str, ...] = ()   # every transfer port, in journey order
+    #: full-load slot cost of the capacity this path occupies (USD/TEU); informational and
+    #: used by the cost-aware selection.  None = not computed (baseline selection).
+    slot_cost_per_teu: Optional[float] = None
+
+    @property
+    def services(self) -> Tuple[int, ...]:
+        return tuple(s.service for s in self.segments)
+
+    @property
+    def n_transfers(self) -> int:
+        return len(self.segments) - 1
+
+    @property
+    def transfer_ports(self) -> Tuple[str, ...]:
+        """All transfer ports (``hubs``; falls back to ``hub`` for a hand-built path)."""
+        if self.hubs:
+            return self.hubs
+        return (self.hub,) if self.hub is not None else ()
