+def _port_cost(port, name: str) -> float:
+    v = getattr(port, name, 0.0) if port is not None else 0.0
+    return float(v) if isinstance(v, (int, float)) and math.isfinite(v) else 0.0
+
+
+class _SlotCosts:
+    """Full-load cost of the capacity a segment occupies.
+
+    One weekly departure of service ``s`` costs ``F_s`` (vessel hire of ``ceil(T/7)``
+    vessels + fuel + fixed port calls: ``ServiceModel.weekly_fixed_cost(1)``) and offers
+    ``C_s`` TEU on every leg.  A TEU that occupies the slot for ``tau`` days of the
+    ``T``-day rotation therefore costs ``F_s * tau / (T * C_s)`` when the vessel is full -
+    a lower bound on its cost on a partly empty service, and the figure a service must
+    earn per TEU to pay for itself.  Everything comes from the canonical service model."""
+
+    def __init__(self, models: Sequence[ServiceModel]):
+        self.models = models
+        self._unit: Dict[int, float] = {}
+
+    def unit(self, si: int) -> float:
+        u = self._unit.get(si)
+        if u is None:
+            m = self.models[si]
+            cyc = m.cycle_days if m.cycle_days > 0 else 1.0
+            u = m.weekly_fixed_cost(1) / (max(m.capacity_teu, 1e-9) * cyc)
+            self._unit[si] = u
+        return u
+
+    def segment(self, si: int, legs: Sequence[int]) -> float:
+        m = self.models[si]
+        slot_days = sum(m.leg_sail_days[l] for l in legs) + m._port_stay_days * len(legs)
+        return self.unit(si) * slot_days
+
+
+def _select_fastest(direct: List[OdPath], transfer: List[OdPath], cap: int) -> List[OdPath]:
+    direct = sorted(direct, key=lambda p: (p.transit_days, p.port_cost_per_teu))
+    transfer = sorted(transfer, key=lambda p: (p.transit_days, p.port_cost_per_teu))
+    return (direct + transfer)[:cap]
+
+
+def _select_cost_aware(cands: List[OdPath], cap: int, penalty: float) -> List[OdPath]:
+    """Greedy selection of ``cap`` paths by carrying cost, with a service-reuse penalty."""
+    def cost(p: OdPath) -> float:
+        return p.port_cost_per_teu + (p.slot_cost_per_teu or 0.0)
+
+    ranked = sorted(cands, key=lambda p: (cost(p), p.transit_days, p.services, p.transfer_ports))
+    if cap >= len(ranked):
+        return ranked
+    lam = penalty * max(cost(ranked[0]), 1.0)
+    used: Counter = Counter()
+    chosen: List[OdPath] = []
+    remaining = ranked
+    while len(chosen) < cap and remaining:
+        if lam > 0.0 and used:
+            best_j, best_v = 0, None
+            for j, p in enumerate(remaining):
+                v = cost(p) + lam * sum(used[s] for s in p.services)
+                if best_v is None or v < best_v - 1e-12:
+                    best_j, best_v = j, v
+        else:
+            best_j = 0
+        p = remaining.pop(best_j)
+        chosen.append(p)
+        for s in p.services:
+            used[s] += 1
+    return chosen
+
+
+def _allocate_budget(rows: List[Tuple[int, int, float]], total: int, cfg: PathConfig) -> Dict[int, int]:
+    """Per-OD path budgets for ``cfg.budget == 'adaptive'``.
+
+    ``rows`` = (od, valid paths, opportunity) with opportunity = demand x (revenue per TEU -
+    cheapest per-TEU port charges): what an OD can contribute at most.  The total number of
+    retained paths equals the baseline's (``total``), so the model has the baseline's size;
+    only its distribution changes - towards the ODs that carry the value, away from ODs of
+    little value, with ``adaptive_min_paths`` / ``adaptive_max_paths`` as bounds."""
+    lo, hi = cfg.adaptive_min_paths, cfg.adaptive_max_paths
+    cap_of = {od: min(hi, n) for od, n, _ in rows}
+    floor_of = {od: min(lo, n) for od, n, _ in rows}
+    w = {od: max(v, 0.0) ** cfg.adaptive_value_exponent + 1e-9 for od, n, v in rows}
+    wsum = sum(w.values()) or 1.0
+    share = {od: total * w[od] / wsum for od in w}
+    k = {od: int(min(cap_of[od], max(floor_of[od], math.floor(share[od])))) for od in w}
+    left = total - sum(k.values())
+    if left > 0:
+        order = sorted(w, key=lambda od: (-(share[od] - k[od]), -w[od], od))
+        while left > 0:
+            moved = False
+            for od in order:
+                if left <= 0:
+                    break
+                if k[od] < cap_of[od]:
+                    k[od] += 1
+                    left -= 1
+                    moved = True
+            if not moved:
+                break
+    elif left < 0:
+        order = sorted(w, key=lambda od: (w[od], od))
+        while left < 0:
+            moved = False
+            for od in order:
+                if left >= 0:
+                    break
+                if k[od] > floor_of[od]:
+                    k[od] -= 1
+                    left += 1
+                    moved = True
+            if not moved:
+                break
+    return k
+
+
+def build_paths(
+    demands: Sequence,
+    models: Sequence[ServiceModel],
+    port_lookup: Dict,
+    assumptions: EconomicsAssumptions = DEFAULT_ASSUMPTIONS,
+    *,
+    max_paths_per_od: int = DEFAULT_MAX_PATHS_PER_OD,
+    config: Optional[PathConfig] = None,
+    only_services: Optional[Sequence[int]] = None,
+) -> Tuple[Dict[int, List[OdPath]], PathStats]:
+    """Enumerate time-feasible paths for every demand with positive weekly TEU and select
+    the ones that enter the network model (``config``; default: the environment).
+
+    ``only_services`` restricts the enumeration to paths whose every segment rides one of
+    those service indices (used by the flow re-optimisation, which only needs paths through
+    operated services); the paths found are exactly the unrestricted enumeration's paths
+    that use only those services."""
+    import time as _time
+    t_start = _time.perf_counter()
+    cfg = config if config is not None else config_from_environment()
+    stats = PathStats(max_paths_per_od=max_paths_per_od, selection=cfg.selection,
+                      max_transfers=cfg.max_transfers, budget=cfg.budget)
+
+    # boarding index: port -> [service]
+    by_port: Dict[str, List[int]] = defaultdict(list)
+    allowed = None if only_services is None else set(only_services)
+    for si, m in enumerate(models):
+        if allowed is not None and si not in allowed:
+            continue
+        for p in m.ports:
+            by_port[p].append(si)
+
+    # ride tables per service: (a, b) -> (legs, days), built lazily
+    ride_cache: Dict[Tuple[int, str, str], Optional[Tuple[Tuple[int, ...], float]]] = {}
+
+    def ride(si: int, a: str, b: str):
+        key = (si, a, b)
+        if key not in ride_cache:
+            ride_cache[key] = models[si].ride(a, b)
+        return ride_cache[key]
+
+    dwell = assumptions.transfer_dwell_days
+    need_cost = cfg.selection in (SELECT_COST_AWARE, SELECT_HYBRID) \
+        or cfg.budget == BUDGET_ADAPTIVE or cfg.max_transfers >= 2
+    slots = _SlotCosts(models) if need_cost else None
+
+    def hub_cost(h: str) -> float:
+        p = port_lookup.get(h)
+        return _port_cost(p, "transshipment_cost") + 2.0 * _port_cost(p, "variable_port_call_cost")
+
+    # per-OD valid paths, in discovery order (pass 1)
+    per_od: Dict[int, Tuple[List[OdPath], List[OdPath], List[OdPath]]] = {}
+
+    for di, d in enumerate(demands):
+        if not (d.weekly_teu > 0):
+            continue
+        stats.od_total += 1
+        o, t = d.origin, d.destination
+        limit = getattr(d, "max_transit_days", None)
+        po, pt = port_lookup.get(o), port_lookup.get(t)
+        if po is None or pt is None:
+            # port costs are never assumed zero: an OD without records cannot be priced
+            stats.od_skipped_missing_port_record += 1
+            stats.od_without_path += 1
+            continue
+        base_cost = (_port_cost(po, "handling_cost") + _port_cost(po, "variable_port_call_cost")
+                     + _port_cost(pt, "handling_cost") + _port_cost(pt, "variable_port_call_cost"))
+
+        direct: List[OdPath] = []
+        transfer: List[OdPath] = []
+        multi: List[OdPath] = []
+        over_limit = 0
+
+        # ---- direct --------------------------------------------------------------
+        for si in by_port.get(o, ()):
+            r = ride(si, o, t)
+            if r is None:
+                continue
+            legs, days = r
+            if limit is not None and days > limit + 1e-9:
+                over_limit += 1
+                continue
+            direct.append(OdPath(
+                od=di, kind=KIND_DIRECT,
+                segments=(PathSegment(si, legs, o, t, days),),
+                hub=None, transit_days=days, port_cost_per_teu=base_cost, hubs=(),
+                slot_cost_per_teu=slots.segment(si, legs) if slots else None,
+            ))
+
+        # ---- one transfer ---------------------------------------------------------
+        # reach_to[h] = [(service, legs, days)] for services that go h -> t
+        reach_to: Dict[str, List[Tuple[int, Tuple[int, ...], float]]] = defaultdict(list)
+        for s2 in (by_port.get(t, ()) if cfg.max_transfers >= 1 else ()):
+            for h in models[s2].ports:
+                if h in (o, t):
+                    continue
+                r2 = ride(s2, h, t)
+                if r2 is not None:
+                    reach_to[h].append((s2, r2[0], r2[1]))
+        if reach_to:
+            for s1 in by_port.get(o, ()):
+                for h in models[s1].ports:
+                    if h in (o, t) or h not in reach_to or h not in port_lookup:
+                        continue
+                    r1 = ride(s1, o, h)
+                    if r1 is None:
+                        continue
+                    hcost = hub_cost(h)
+                    for s2, legs2, days2 in reach_to[h]:
+                        if s2 == s1:
+                            continue
+                        total = r1[1] + dwell + days2
+                        if limit is not None and total > limit + 1e-9:
+                            over_limit += 1
+                            continue
+                        transfer.append(OdPath(
+                            od=di, kind=KIND_TRANSFER,
+                            segments=(PathSegment(s1, r1[0], o, h, r1[1]),
+                                      PathSegment(s2, legs2, h, t, days2)),
+                            hub=h, transit_days=total, port_cost_per_teu=base_cost + hcost,
+                            hubs=(h,),
+                            slot_cost_per_teu=(slots.segment(s1, r1[0]) + slots.segment(s2, legs2))
+                            if slots else None,
+                        ))
+
+        # ---- two transfers (bounded; only where the shorter journeys are too few) -----
+        if cfg.max_transfers >= 2 and (len(direct) + len(transfer)) < cfg.multi_hop_min_alternatives:
+            t_mh = _time.perf_counter()
+            multi, mh_over = _two_transfer_paths(
+                di, o, t, limit, models, by_port, ride, dwell, base_cost, port_lookup,
+                hub_cost, slots, cfg)
+            over_limit += mh_over
+            stats.od_multi_hop_enumerated += 1
+            stats.paths_multi_hop_valid += len(multi)
+            stats.multi_hop_build_sec += _time.perf_counter() - t_mh
+            if multi and not (direct or transfer):
+                stats.od_rescued_by_multi_hop += 1
+
+        stats.paths_dropped_by_time_limit += over_limit
+        stats.paths_valid += len(direct) + len(transfer) + len(multi)
+        if direct or transfer or multi:
+            per_od[di] = (direct, transfer, multi)
+        else:
+            stats.od_without_path += 1
+            if over_limit:
+                stats.od_without_path_time_limit += 1
+            else:
+                stats.od_without_path_no_connection += 1
+
+    # ---- pass 2: budgets and selection ------------------------------------------------
+    caps: Dict[int, int] = {}
+    if cfg.budget == BUDGET_ADAPTIVE and per_od:
+        total = sum(min(max_paths_per_od, len(a) + len(b) + len(c)) for a, b, c in per_od.values())
+        rows = []
+        for di, (a, b, c) in per_od.items():
+            d = demands[di]
+            cheapest_port = min(p.port_cost_per_teu for p in (a + b + c))
+            rows.append((di, len(a) + len(b) + len(c),
+                         d.weekly_teu * max(0.0, float(d.revenue_per_teu) - cheapest_port)))
+        caps = _allocate_budget(rows, total, cfg)
+
+    paths: Dict[int, List[OdPath]] = {}
+    for di, (direct, transfer, multi) in per_od.items():
+        cap = caps.get(di, max_paths_per_od)
+        n_valid = len(direct) + len(transfer) + len(multi)
+        if cfg.selection == SELECT_FASTEST:
+            multi_sorted = sorted(multi, key=lambda p: (p.transit_days, p.port_cost_per_teu))
+            kept = _select_fastest(direct, transfer, cap)
+            if multi_sorted and len(kept) < cap:
+                kept = kept + multi_sorted[:cap - len(kept)]
+        elif cfg.selection == SELECT_HYBRID:
+            n_cost = min(cfg.hybrid_cost_slots, cap)
+            kept = _select_fastest(direct, transfer, cap - n_cost)
+            multi_sorted = sorted(multi, key=lambda p: (p.transit_days, p.port_cost_per_teu))
+            if multi_sorted and len(kept) < cap - n_cost:
+                kept = kept + multi_sorted[:cap - n_cost - len(kept)]
+            have = {(p.services, p.transfer_ports) for p in kept}
+            rest = [p for p in direct + transfer + multi if (p.services, p.transfer_ports) not in have]
+            kept = kept + _select_cost_aware(rest, cap - len(kept), cfg.diversity_penalty)
+        else:
+            kept = _select_cost_aware(direct + transfer + multi, cap, cfg.diversity_penalty)
+        if n_valid > cap:
+            stats.od_at_cap += 1
+        stats.paths_dropped_by_cap += n_valid - len(kept)
+        paths[di] = kept
+        stats.paths_built += len(kept)
+        stats.paths_multi_hop_kept += sum(1 for p in kept if p.kind == KIND_TRANSFER2)
+        if direct:
+            stats.od_with_direct += 1
+        else:
+            stats.od_transfer_only += 1
+    stats.signals = _network_signals(demands, models, per_od, paths, caps, max_paths_per_od)
+    stats.path_build_sec = _time.perf_counter() - t_start
+    return paths, stats
+
+
+def _network_signals(demands, models, per_od, kept, caps, base_cap) -> Dict:
+    """Signals of the candidate network that drive the path budgets and the multi-hop policy
+    (and are reported with the result).  Pure functions of the demand list, the service
+    models and the valid paths; nothing is invented, a quantity that cannot be computed is
+    absent.  Demand weights are weekly TEU."""
+    tot = sum(d.weekly_teu for d in demands if d.weekly_teu > 0) or 0.0
+    if tot <= 0:
+        return {}
+    bins = [("0", 0, 0), ("1", 1, 1), ("2-4", 2, 4), ("5-9", 5, 9), ("10+", 10, 10 ** 9)]
+    od_n = {b: 0 for b, _, _ in bins}
+    teu_n = {b: 0.0 for b, _, _ in bins}
+    direct_teu = 0.0
+    single_service_teu = 0.0                 # every kept path rides one service (no choice)
+    teus = []
+    for di, d in enumerate(demands):
+        if not d.weekly_teu > 0:
+            continue
+        teus.append(d.weekly_teu)
+        a, b, c = per_od.get(di, ([], [], []))
+        n = len(a) + len(b) + len(c)
+        for name, lo, hi in bins:
+            if lo <= n <= hi:
+                od_n[name] += 1
+                teu_n[name] += d.weekly_teu
+                break
+        if a:
+            direct_teu += d.weekly_teu
+        if n == 1:
+            single_service_teu += d.weekly_teu
+    teus.sort(reverse=True)
+    ports_svc: Dict[str, int] = defaultdict(int)
+    for m in models:
+        for p in m.ports:
+            ports_svc[p] += 1
+    counts = sorted(ports_svc.values())
+    hub_use: Counter = Counter()
+    n_transfer_paths = 0
+    for pl in kept.values():
+        for p in pl:
+            for h in p.transfer_ports:
+                hub_use[h] += 1
+            if p.transfer_ports:
+                n_transfer_paths += 1
+    top3 = sum(v for _, v in hub_use.most_common(3))
+    allocs = sorted(caps.values()) if caps else []
+    return {
+        "demand_teu": tot,
+        "od_by_valid_paths": od_n,
+        "demand_share_by_valid_paths": {k: v / tot for k, v in teu_n.items()},
+        "demand_share_with_direct_path": direct_teu / tot,
+        "demand_share_without_any_path": teu_n["0"] / tot,
+        "demand_share_with_a_single_path": single_service_teu / tot,
+        "demand_concentration": {
+            "top10_od_share": sum(teus[:10]) / tot, "top100_od_share": sum(teus[:100]) / tot,
+            "od_count": len(teus),
+            "herfindahl": sum((t / tot) ** 2 for t in teus)},
+        "port_connectivity": {
+            "ports": len(counts), "services_per_port_min": counts[0] if counts else None,
+            "services_per_port_median": counts[len(counts) // 2] if counts else None,
+            "services_per_port_max": counts[-1] if counts else None,
+            "ports_with_at_most_one_service": sum(1 for c in counts if c <= 1)},
+        "transfer_concentration": {
+            "kept_paths_with_transfer": n_transfer_paths,
+            "top3_transfer_port_share": (top3 / max(1, sum(hub_use.values()))),
+            "distinct_transfer_ports": len(hub_use)},
+        "path_budget": {"baseline_per_od": base_cap,
+                         "allocated_min": allocs[0] if allocs else base_cap,
+                         "allocated_max": allocs[-1] if allocs else base_cap,
+                         "allocated_median": allocs[len(allocs) // 2] if allocs else base_cap},
+    }
+
+
+def _two_transfer_paths(di, o, t, limit, models, by_port, ride, dwell, base_cost, port_lookup,
+                        hub_cost, slots, cfg):
+    """Time-feasible journeys ``o -s1-> h1 -s2-> h2 -s3-> t`` with three distinct services
+    and four distinct ports.  Bounded three ways: the ``multi_hop_legs_per_hub`` fastest
+    first / last legs per hub are combined, a combination is abandoned as soon as its fastest
+    possible time exceeds the limit, and only the ``multi_hop_pool_per_od`` cheapest
+    journeys are returned.  Returns (paths, number dropped by the time limit)."""
+    firsts: Dict[str, List[Tuple[float, int, Tuple[int, ...]]]] = defaultdict(list)
+    for s1 in by_port.get(o, ()):
+        for h1 in models[s1].ports:
+            if h1 == o or h1 == t or h1 not in port_lookup:
+                continue
+            r1 = ride(s1, o, h1)
+            if r1 is not None:
+                firsts[h1].append((r1[1], s1, r1[0]))
+    if not firsts:
+        return [], 0
+    lasts: Dict[str, List[Tuple[float, int, Tuple[int, ...]]]] = defaultdict(list)
+    for s3 in by_port.get(t, ()):
+        for h2 in models[s3].ports:
+            if h2 == o or h2 == t or h2 not in port_lookup:
+                continue
+            r3 = ride(s3, h2, t)
+            if r3 is not None:
+                lasts[h2].append((r3[1], s3, r3[0]))
+    if not lasts:
+        return [], 0
+    m = cfg.multi_hop_legs_per_hub
+    for dct in (firsts, lasts):
+        for h, lst in dct.items():
+            lst.sort()
+            del lst[m:]
+
+    out: List[Tuple[float, OdPath]] = []
+    over = 0
+    two_dwell = 2.0 * dwell
+    for h1, f_list in firsts.items():
+        d1_min = f_list[0][0]
+        c1 = hub_cost(h1)
+        for s2 in by_port.get(h1, ()):
+            for h2 in models[s2].ports:
+                if h2 == h1 or h2 not in lasts:
+                    continue
+                r2 = ride(s2, h1, h2)
+                if r2 is None:
+                    continue
+                if limit is not None and d1_min + r2[1] + lasts[h2][0][0] + two_dwell > limit + 1e-9:
+                    over += 1
+                    continue
+                c2 = hub_cost(h2)
+                for d1, s1, l1 in f_list:
+                    if s1 == s2:
+                        continue
+                    for d3, s3, l3 in lasts[h2]:
+                        if s3 == s2 or s3 == s1:
+                            continue
+                        total = d1 + dwell + r2[1] + dwell + d3
+                        if limit is not None and total > limit + 1e-9:
+                            over += 1
+                            continue
+                        slot = (slots.segment(s1, l1) + slots.segment(s2, r2[0])
+                                + slots.segment(s3, l3)) if slots else None
+                        port_c = base_cost + c1 + c2
+                        key = port_c + (slot or 0.0)
+                        out.append((key, OdPath(
+                            od=di, kind=KIND_TRANSFER2,
+                            segments=(PathSegment(s1, l1, o, h1, d1),
+                                      PathSegment(s2, r2[0], h1, h2, r2[1]),
+                                      PathSegment(s3, l3, h2, t, d3)),
+                            hub=h1, transit_days=total, port_cost_per_teu=port_c,
+                            hubs=(h1, h2), slot_cost_per_teu=slot)))
+    out.sort(key=lambda kp: (kp[0], kp[1].transit_days, kp[1].services, kp[1].hubs))
+    return [p for _, p in out[:cfg.multi_hop_pool_per_od]], over
