+"""OD path enumeration over closed service rotations.
+
+A path carries one OD's cargo either on a single service (``direct``), on two services
+connected at a transshipment hub (``transfer``; one transfer) or - Task 20, bounded and
+opt-in - on three services connected at two hubs (``transfer2``; two transfers, the hard
+upper bound of the model: ``HARD_MAX_TRANSFERS``).  Each segment rides a closed rotation
+forward from its boarding port to its alighting port, wrapping around the closing leg, so
+the legs it consumes are known exactly (leg-level capacity). Transit time is real:
+
+    sailing days of every ridden leg
+  + one port stay at each intermediate port
+  + at every hub: minimum transshipment handling time + expected wait for the
+    connecting departure
+
+and a path whose transit time exceeds the OD's ``max_transit_days`` is NEVER built
+(end-to-end time limit enforced at construction). An OD without a time limit in the
+source is unconstrained - a limit is not invented.
+
+Per-TEU port charges of a path (all USD/TEU, from the Port records):
+    origin load        handling_cost + variable_port_call_cost
+    destination unload handling_cost + variable_port_call_cost
+    transfer at a hub  transshipment_cost + 2 * variable_port_call_cost
+                       (transshipment_cost replaces the discharge+reload lifts)
+
+Which of the valid paths of an OD enter the optimisation model is a *selection*, because
+the model's size grows with the number of paths (``PathConfig``):
+
+    ``fastest``     (baseline, default) direct paths first, then the fastest transfers,
+                    at most ``max_paths_per_od``.  Transit time is a constraint of the
+                    model, not a benefit, so this order carries no economic information.
+    ``hybrid``      (Task 20) the ``fastest`` rule for all but ``hybrid_cost_slots`` of the
+                    slots, which go to the cheapest remaining paths (cost-aware rule).
+    ``cost_aware``  (Task 20) the paths whose *cost of carrying one TEU* is lowest: the
+                    per-TEU port charges plus the share of the weekly cost of the capacity
+                    the path occupies (full-load slot cost, canonical service model).  A
+                    reuse penalty keeps the retained set from consisting of near-duplicates
+                    of one cheap service; revenue is a property of the OD, not of the path,
+                    so it does not enter the ranking.  The model still decides which of the
+                    retained paths carry cargo; no flow is fixed here.
+
+Modelling limits (reported, not hidden): at most ``max_transfers`` transfers (1 by default;
+2 is the hard bound); at most the per-OD budget of paths per OD.
+"""
+
+from __future__ import annotations
+
+import math
+import os
+from collections import Counter, defaultdict
+from dataclasses import dataclass, field
+from typing import Dict, List, Optional, Sequence, Tuple
+
+from src.network.economics import DEFAULT_ASSUMPTIONS, EconomicsAssumptions, ServiceModel
+
+DEFAULT_MAX_PATHS_PER_OD = 10
+
+#: A journey has at most this many transfers (three services).  Unrestricted path length is
+#: not modelled and cannot be configured.
+HARD_MAX_TRANSFERS = 2
+
+ENV_SELECTION = "LINER_PATH_SELECTION"          # fastest | cost_aware
+ENV_MAX_TRANSFERS = "LINER_MAX_TRANSFERS"       # 1 | 2
+ENV_BUDGET = "LINER_PATH_BUDGET"                # fixed | adaptive
+ENV_MULTI_HOP_MIN_ALT = "LINER_PATH_MULTI_HOP_MIN_ALT"
+ENV_HYBRID_SLOTS = "LINER_PATH_HYBRID_SLOTS"        # cost-aware slots of the hybrid rule
+ENV_FLOW_REOPT = "LINER_FLOW_REOPT"                 # 1: re-route cargo over ALL valid paths
+ENV_FLOOR_REPAIR = "LINER_PROFIT_FLOOR_REPAIR"      # 1: switch off losing services below the floor
+ENV_PATH_INCLUDE = "LINER_PATH_INCLUDE"             # K >= 1: restriction-aware path set (opt-in, default 0)
+
+SELECT_FASTEST = "fastest"
+SELECT_COST_AWARE = "cost_aware"
+SELECT_HYBRID = "hybrid"
+BUDGET_FIXED = "fixed"
+BUDGET_ADAPTIVE = "adaptive"
+
+KIND_DIRECT = "direct"
+KIND_TRANSFER = "transfer"
+KIND_TRANSFER2 = "transfer2"
+
+
+@dataclass(frozen=True)
+class PathConfig:
+    """How the path set of the network model is built (see the module docstring)."""
+
+    selection: str = SELECT_FASTEST
+    #: transfers a journey may have; 2 is the hard bound.  Default 2 (Task 20): journeys with two
+    #: transfers are enumerated only for ODs with no direct / one-transfer journey
+    #: (``multi_hop_min_alternatives``) and, for the flow re-optimisation, through operated services
+    max_transfers: int = 2
+    budget: str = BUDGET_FIXED
+    #: ``hybrid`` selection: slots (of the per-OD budget) given to the cheapest paths
+    hybrid_cost_slots: int = 3
+    #: after the global MILP, re-route the cargo of the (fixed) network over the full valid
+    #: path set (``src/network/flow_reopt.py``): same services, frequencies and vessels.
+    #: Default ON (Task 20): never lowers profit or coverage, ledger-verified
+    reoptimize_flows: bool = True
+    #: when the plan's profit is below the approved floor (0), switch off the worst services
+    #: and re-route (``flow_reopt.repair_profit_floor``); a plan at or above the floor is untouched.
+    #: Default ON (Task 20)
+    repair_profit_floor: bool = True
+    #: two-transfer paths are enumerated only for an OD with fewer than this many valid
+    #: direct / one-transfer paths ("where needed"); 1 = only ODs with none
+    multi_hop_min_alternatives: int = 1
+    #: at most this many two-transfer paths per OD are kept for selection (cheapest first)
+    multi_hop_pool_per_od: int = 24
+    #: first/last-leg alternatives kept per hub during two-transfer enumeration
+    multi_hop_legs_per_hub: int = 4
+    #: cost-aware reuse penalty, as a fraction of the cheapest path's cost, charged per
+    #: already-retained path that rides the same service
+    diversity_penalty: float = 0.10
+    #: adaptive budget: bounds of the per-OD allocation and the damping exponent
+    adaptive_min_paths: int = 3
+    adaptive_max_paths: int = 20
+    adaptive_value_exponent: float = 0.5
+
+    def __post_init__(self):
+        if self.selection not in (SELECT_FASTEST, SELECT_COST_AWARE, SELECT_HYBRID):
+            raise ValueError(f"path selection must be 'fastest', 'cost_aware' or 'hybrid', "
+                             f"got {self.selection!r}")
+        if self.hybrid_cost_slots < 0:
+            raise ValueError("hybrid_cost_slots must be >= 0")
+        if not (isinstance(self.max_transfers, int) and 0 <= self.max_transfers <= HARD_MAX_TRANSFERS):
+            raise ValueError(f"max_transfers must be an integer in [0, {HARD_MAX_TRANSFERS}] "
+                             f"(unrestricted path length is not supported), got {self.max_transfers!r}")
+        if self.budget not in (BUDGET_FIXED, BUDGET_ADAPTIVE):
+            raise ValueError(f"path budget must be 'fixed' or 'adaptive', got {self.budget!r}")
+        if self.multi_hop_min_alternatives < 0 or self.multi_hop_pool_per_od < 1 \
+                or self.multi_hop_legs_per_hub < 1:
+            raise ValueError("multi-hop limits must be positive")
+        if not (0.0 <= self.diversity_penalty <= 5.0):
+            raise ValueError("diversity_penalty must be in [0, 5]")
+        if not (1 <= self.adaptive_min_paths <= self.adaptive_max_paths):
+            raise ValueError("need 1 <= adaptive_min_paths <= adaptive_max_paths")
+
+    def describe(self) -> Dict:
+        return dict(self.__dict__)
+
+
+def path_include_from_environment(env: Optional[Dict[str, str]] = None) -> int:
+    """``LINER_PATH_INCLUDE=K``: after the LP relaxation has chosen the services the integer problem
+    may use, rebuild the per-OD path set from the paths that ride ONLY those services, keeping the
+    K fastest per OD (the path slots of the baseline are partly spent on paths through services the
+    restricted problem cannot use).  Unset / 0 = off.  Malformed values raise ``ValueError``."""
+    raw = ((os.environ if env is None else env).get(ENV_PATH_INCLUDE) or "").strip()
+    if not raw:
+        return 0
+    try:
+        k = int(raw)
+    except ValueError:
+        raise ValueError(f"{ENV_PATH_INCLUDE} must be a non-negative integer, got {raw!r}") from None
+    if k < 0 or k > 1000:
+        raise ValueError(f"{ENV_PATH_INCLUDE} must be in [0, 1000], got {k}")
+    return k
+
+
+def config_from_environment(env: Optional[Dict[str, str]] = None) -> PathConfig:
+    """Path configuration in force.  Every variable is optional; unset = the field default.
+    A malformed value raises ``ValueError`` (never silently replaced)."""
+    e = os.environ if env is None else env
+    kw: Dict = {}
+    sel = (e.get(ENV_SELECTION) or "").strip().lower()
+    if sel:
+        kw["selection"] = sel
+    mt = (e.get(ENV_MAX_TRANSFERS) or "").strip()
+    if mt:
+        try:
+            kw["max_transfers"] = int(mt)
+        except ValueError:
+            raise ValueError(f"{ENV_MAX_TRANSFERS} must be an integer, got {mt!r}") from None
+    bud = (e.get(ENV_BUDGET) or "").strip().lower()
+    if bud:
+        kw["budget"] = bud
+    hs = (e.get(ENV_HYBRID_SLOTS) or "").strip()
+    if hs:
+        try:
+            kw["hybrid_cost_slots"] = int(hs)
+        except ValueError:
+            raise ValueError(f"{ENV_HYBRID_SLOTS} must be an integer, got {hs!r}") from None
+    for env_name, field_name in ((ENV_FLOOR_REPAIR, "repair_profit_floor"),
+                                 (ENV_FLOW_REOPT, "reoptimize_flows")):
+        raw = (e.get(env_name) or "").strip().lower()
+        if raw in ("1", "true", "yes", "on"):
+            kw[field_name] = True
+        elif raw in ("0", "false", "no", "off"):
+            kw[field_name] = False
+        elif raw != "":
+            raise ValueError(f"{env_name} must be 0 or 1, got {raw!r}")
+    alt = (e.get(ENV_MULTI_HOP_MIN_ALT) or "").strip()
+    if alt:
+        try:
+            kw["multi_hop_min_alternatives"] = int(alt)
+        except ValueError:
+            raise ValueError(f"{ENV_MULTI_HOP_MIN_ALT} must be an integer, got {alt!r}") from None
+    return PathConfig(**kw)
+
