-def build_paths(
-    demands: Sequence,
-    models: Sequence[ServiceModel],
-    port_lookup: Dict,
-    assumptions: EconomicsAssumptions = DEFAULT_ASSUMPTIONS,
-    *,
-    max_paths_per_od: int = DEFAULT_MAX_PATHS_PER_OD,
-    config: Optional[PathConfig] = None,
-    only_services: Optional[Sequence[int]] = None,
-) -> Tuple[Dict[int, List[OdPath]], PathStats]:
-    """Enumerate time-feasible paths for every demand with positive weekly TEU and select
-    the ones that enter the network model (``config``; default: the environment).
-
-    ``only_services`` restricts the enumeration to paths whose every segment rides one of
-    those service indices (used by the flow re-optimisation, which only needs paths through
-    operated services); the paths found are exactly the unrestricted enumeration's paths
-    that use only those services."""
-    import time as _time
-    t_start = _time.perf_counter()
-    cfg = config if config is not None else config_from_environment()
-    stats = PathStats(max_paths_per_od=max_paths_per_od, selection=cfg.selection,
-                      max_transfers=cfg.max_transfers, budget=cfg.budget)
-
-    # boarding index: port -> [service]
-    by_port: Dict[str, List[int]] = defaultdict(list)
-    allowed = None if only_services is None else set(only_services)
-    for si, m in enumerate(models):
-        if allowed is not None and si not in allowed:
-            continue
-        for p in m.ports:
-            by_port[p].append(si)
-
-    # ride tables per service: (a, b) -> (legs, days), built lazily
-    ride_cache: Dict[Tuple[int, str, str], Optional[Tuple[Tuple[int, ...], float]]] = {}
-
-    def ride(si: int, a: str, b: str):
-        key = (si, a, b)
-        if key not in ride_cache:
-            ride_cache[key] = models[si].ride(a, b)
-        return ride_cache[key]
-
-    dwell = assumptions.transfer_dwell_days
-    need_cost = cfg.selection in (SELECT_COST_AWARE, SELECT_HYBRID) \
-        or cfg.budget == BUDGET_ADAPTIVE or cfg.max_transfers >= 2
-    slots = _SlotCosts(models) if need_cost else None
-
-    def hub_cost(h: str) -> float:
-        p = port_lookup.get(h)
-        return _port_cost(p, "transshipment_cost") + 2.0 * _port_cost(p, "variable_port_call_cost")
-
-    # per-OD valid paths, in discovery order (pass 1)
-    per_od: Dict[int, Tuple[List[OdPath], List[OdPath], List[OdPath]]] = {}
-
-    for di, d in enumerate(demands):
-        if not (d.weekly_teu > 0):
-            continue
-        stats.od_total += 1
-        o, t = d.origin, d.destination
-        limit = getattr(d, "max_transit_days", None)
-        po, pt = port_lookup.get(o), port_lookup.get(t)
-        if po is None or pt is None:
-            # port costs are never assumed zero: an OD without records cannot be priced
-            stats.od_skipped_missing_port_record += 1
-            stats.od_without_path += 1
-            continue
-        base_cost = (_port_cost(po, "handling_cost") + _port_cost(po, "variable_port_call_cost")
-                     + _port_cost(pt, "handling_cost") + _port_cost(pt, "variable_port_call_cost"))
-
-        direct: List[OdPath] = []
-        transfer: List[OdPath] = []
-        multi: List[OdPath] = []
-        over_limit = 0
-
-        # ---- direct --------------------------------------------------------------
-        for si in by_port.get(o, ()):
-            r = ride(si, o, t)
-            if r is None:
-                continue
-            legs, days = r
-            if limit is not None and days > limit + 1e-9:
-                over_limit += 1
-                continue
-            direct.append(OdPath(
-                od=di, kind=KIND_DIRECT,
-                segments=(PathSegment(si, legs, o, t, days),),
-                hub=None, transit_days=days, port_cost_per_teu=base_cost, hubs=(),
-                slot_cost_per_teu=slots.segment(si, legs) if slots else None,
-            ))
-
-        # ---- one transfer ---------------------------------------------------------
-        # reach_to[h] = [(service, legs, days)] for services that go h -> t
-        reach_to: Dict[str, List[Tuple[int, Tuple[int, ...], float]]] = defaultdict(list)
-        for s2 in (by_port.get(t, ()) if cfg.max_transfers >= 1 else ()):
-            for h in models[s2].ports:
-                if h in (o, t):
-                    continue
-                r2 = ride(s2, h, t)
-                if r2 is not None:
-                    reach_to[h].append((s2, r2[0], r2[1]))
-        if reach_to:
-            for s1 in by_port.get(o, ()):
-                for h in models[s1].ports:
-                    if h in (o, t) or h not in reach_to or h not in port_lookup:
-                        continue
-                    r1 = ride(s1, o, h)
-                    if r1 is None:
-                        continue
-                    hcost = hub_cost(h)
-                    for s2, legs2, days2 in reach_to[h]:
-                        if s2 == s1:
-                            continue
-                        total = r1[1] + dwell + days2
-                        if limit is not None and total > limit + 1e-9:
-                            over_limit += 1
-                            continue
-                        transfer.append(OdPath(
-                            od=di, kind=KIND_TRANSFER,
-                            segments=(PathSegment(s1, r1[0], o, h, r1[1]),
-                                      PathSegment(s2, legs2, h, t, days2)),
-                            hub=h, transit_days=total, port_cost_per_teu=base_cost + hcost,
-                            hubs=(h,),
-                            slot_cost_per_teu=(slots.segment(s1, r1[0]) + slots.segment(s2, legs2))
-                            if slots else None,
-                        ))
-
-        # ---- two transfers (bounded; only where the shorter journeys are too few) -----
-        if cfg.max_transfers >= 2 and (len(direct) + len(transfer)) < cfg.multi_hop_min_alternatives:
-            t_mh = _time.perf_counter()
-            multi, mh_over = _two_transfer_paths(
-                di, o, t, limit, models, by_port, ride, dwell, base_cost, port_lookup,
-                hub_cost, slots, cfg)
