-        caps = _allocate_budget(rows, total, cfg)
-
-    paths: Dict[int, List[OdPath]] = {}
-    for di, (direct, transfer, multi) in per_od.items():
-        cap = caps.get(di, max_paths_per_od)
-        n_valid = len(direct) + len(transfer) + len(multi)
-        if cfg.selection == SELECT_FASTEST:
-            multi_sorted = sorted(multi, key=lambda p: (p.transit_days, p.port_cost_per_teu))
-            kept = _select_fastest(direct, transfer, cap)
-            if multi_sorted and len(kept) < cap:
-                kept = kept + multi_sorted[:cap - len(kept)]
-        elif cfg.selection == SELECT_HYBRID:
