-class _SlotCosts:
-    """Full-load cost of the capacity a segment occupies.
-
-    One weekly departure of service ``s`` costs ``F_s`` (vessel hire of ``ceil(T/7)``
-    vessels + fuel + fixed port calls: ``ServiceModel.weekly_fixed_cost(1)``) and offers
-    ``C_s`` TEU on every leg.  A TEU that occupies the slot for ``tau`` days of the
-    ``T``-day rotation therefore costs ``F_s * tau / (T * C_s)`` when the vessel is full -
-    a lower bound on its cost on a partly empty service, and the figure a service must
-    earn per TEU to pay for itself.  Everything comes from the canonical service model."""
-
-    def __init__(self, models: Sequence[ServiceModel]):
-        self.models = models
-        self._unit: Dict[int, float] = {}
-
-    def unit(self, si: int) -> float:
-        u = self._unit.get(si)
-        if u is None:
-            m = self.models[si]
-            cyc = m.cycle_days if m.cycle_days > 0 else 1.0
-            u = m.weekly_fixed_cost(1) / (max(m.capacity_teu, 1e-9) * cyc)
-            self._unit[si] = u
-        return u
-
-    def segment(self, si: int, legs: Sequence[int]) -> float:
-        m = self.models[si]
-        slot_days = sum(m.leg_sail_days[l] for l in legs) + m._port_stay_days * len(legs)
-        return self.unit(si) * slot_days
-
-
-def _select_fastest(direct: List[OdPath], transfer: List[OdPath], cap: int) -> List[OdPath]:
-    direct = sorted(direct, key=lambda p: (p.transit_days, p.port_cost_per_teu))
-    transfer = sorted(transfer, key=lambda p: (p.transit_days, p.port_cost_per_teu))
-    return (direct + transfer)[:cap]
-
-
-def _select_cost_aware(cands: List[OdPath], cap: int, penalty: float) -> List[OdPath]:
-    """Greedy selection of ``cap`` paths by carrying cost, with a service-reuse penalty."""
-    def cost(p: OdPath) -> float:
-        return p.port_cost_per_teu + (p.slot_cost_per_teu or 0.0)
-
-    ranked = sorted(cands, key=lambda p: (cost(p), p.transit_days, p.services, p.transfer_ports))
-    if cap >= len(ranked):
-        return ranked
-    lam = penalty * max(cost(ranked[0]), 1.0)
-    used: Counter = Counter()
-    chosen: List[OdPath] = []
-    remaining = ranked
-    while len(chosen) < cap and remaining:
-        if lam > 0.0 and used:
-            best_j, best_v = 0, None
-            for j, p in enumerate(remaining):
-                v = cost(p) + lam * sum(used[s] for s in p.services)
-                if best_v is None or v < best_v - 1e-12:
-                    best_j, best_v = j, v
-        else:
-            best_j = 0
-        p = remaining.pop(best_j)
-        chosen.append(p)
-        for s in p.services:
-            used[s] += 1
-    return chosen
-
-
-def _allocate_budget(rows: List[Tuple[int, int, float]], total: int, cfg: PathConfig) -> Dict[int, int]:
-    """Per-OD path budgets for ``cfg.budget == 'adaptive'``.
-
-    ``rows`` = (od, valid paths, opportunity) with opportunity = demand x (revenue per TEU -
-    cheapest per-TEU port charges): what an OD can contribute at most.  The total number of
-    retained paths equals the baseline's (``total``), so the model has the baseline's size;
-    only its distribution changes - towards the ODs that carry the value, away from ODs of
-    little value, with ``adaptive_min_paths`` / ``adaptive_max_paths`` as bounds."""
-    lo, hi = cfg.adaptive_min_paths, cfg.adaptive_max_paths
-    cap_of = {od: min(hi, n) for od, n, _ in rows}
-    floor_of = {od: min(lo, n) for od, n, _ in rows}
-    w = {od: max(v, 0.0) ** cfg.adaptive_value_exponent + 1e-9 for od, n, v in rows}
-    wsum = sum(w.values()) or 1.0
-    share = {od: total * w[od] / wsum for od in w}
-    k = {od: int(min(cap_of[od], max(floor_of[od], math.floor(share[od])))) for od in w}
-    left = total - sum(k.values())
-    if left > 0:
-        order = sorted(w, key=lambda od: (-(share[od] - k[od]), -w[od], od))
-        while left > 0:
-            moved = False
-            for od in order:
-                if left <= 0:
-                    break
-                if k[od] < cap_of[od]:
-                    k[od] += 1
-                    left -= 1
-                    moved = True
-            if not moved:
-                break
-    elif left < 0:
-        order = sorted(w, key=lambda od: (w[od], od))
-        while left < 0:
-            moved = False
-            for od in order:
-                if left >= 0:
-                    break
-                if k[od] > floor_of[od]:
-                    k[od] -= 1
-                    left += 1
-                    moved = True
-            if not moved:
-                break
-    return k
-
