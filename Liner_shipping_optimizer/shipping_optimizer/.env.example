# =========================================================
# AI Vessel Routing System — Environment Variable Template
# =========================================================
# Copy this file to `.env` and fill in real values. NEVER commit
# the real `.env`; it is gitignored. Placeholders below are safe
# for public/open-source distribution.
# =========================================================

# =========================================================
# Multi-provider LLM configuration (provider-independent)
# =========================================================
# The pipeline tries providers in the order LLM_PROVIDER_ORDER.
# Each provider is OpenAI-compatible. The architecture does NOT
# assume any specific model is available — model availability is
# verified against the configured API key at health-check time.
#
# To use a provider, set its API key. To disable a provider,
# leave its API key blank.

# ----- Groq (primary) -----
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_ORCHESTRATOR_MODEL=qwen/qwen3.8-27b
GROQ_COORDINATOR_MODEL=qwen/qwen3.8-27b
GROQ_REGIONAL_MODEL=qwen/qwen3.8-27b
GROQ_SERVICE_GENERATOR_MODEL=qwen/qwen3.8-27b
GROQ_ITERATION_SELECTOR_MODEL=qwen/qwen3.8-27b
# Same-provider backups, tried in order when the role model fails / is rate
# limited.  Groq quotas are per model (1K req/day, 200K tok/day each).
GROQ_FALLBACK_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
GROQ_TIMEOUT_SEC=30
GROQ_MAX_RETRIES=1

# ----- OpenRouter (secondary, free-tier models) -----
# Free-tier availability is per-account; the health probe validates
# each configured model against the actual API key at runtime.
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Default to the largest known-working free model.  Override with any other
# free model after running the health probe.  Note: many ":free" models
# return reasoning-only content (empty `content` field) and are NOT usable
# with this adapter.
OPENROUTER_ORCHESTRATOR_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_COORDINATOR_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_REGIONAL_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_SERVICE_GENERATOR_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_ITERATION_SELECTOR_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_TIMEOUT_SEC=30
OPENROUTER_MAX_RETRIES=1

# ----- Google Gemini / Google AI Studio (tertiary) -----
GOOGLE_API_KEY=replace-with-your-google-api-key
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Prefer the -latest aliases.  2.0-flash is deprecated; 2.5-flash and
# 2.5-flash-lite are no longer available to new users.
GOOGLE_ORCHESTRATOR_MODEL=gemini-flash-lite-latest
GOOGLE_COORDINATOR_MODEL=gemini-flash-lite-latest
GOOGLE_REGIONAL_MODEL=gemini-flash-lite-latest
GOOGLE_SERVICE_GENERATOR_MODEL=gemini-flash-lite-latest
GOOGLE_ITERATION_SELECTOR_MODEL=gemini-flash-lite-latest
GOOGLE_TIMEOUT_SEC=30
GOOGLE_MAX_RETRIES=1

# ----- Routing policy -----
# CSV. Tried in order; first healthy provider wins.  Failover is automatic
# on HTTP 429 / timeout / connection error / invalid JSON / etc.
LLM_PROVIDER_ORDER=groq,openrouter,google

# 429 cooldown (seconds) before a rate-limited provider/model is re-probed.
LLM_429_COOLDOWN_SEC=60
# Per-provider failure threshold to open the breaker (advanced).
LLM_PROVIDER_FAILURE_THRESHOLD=2
# Enable / disable cross-provider failover.
LLM_ENABLE_PROVIDER_FAILOVER=true
# When ALL providers fail, fall back to deterministic rule-based weights.
LLM_ENABLE_DETERMINISTIC_FALLBACK=true
# Cache identical (model, prompt) pairs to avoid re-billing the same prompt.
LLM_CACHE_ENABLED=true
# Per-request timeout (overrides per-provider default if set).
LLM_REQUEST_TIMEOUT_SEC=30

# =========================================================
# Optimization Hyperparameters
# =========================================================
GA_POPULATION_SIZE=80
GA_GENERATIONS=120
MILP_TIME_LIMIT=120
